{
  "name": "ernie-harness",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "tsx src/cli/main.ts serve",
    "start": "node dist/cli/main.js serve",
    "cli": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/browser-qa.mjs --isolated",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "benchmark:agent": "tsx src/cli/headless.ts",
    "broker": "tsx src/broker/main.ts",
    "benchmark:runner": "tsx src/benchmark/runner.ts",
    "site:preview": "node scripts/site-preview.mjs",
    "site:qa": "node scripts/site-qa.mjs",
    "site:social": "node scripts/site-social.mjs",
    "package:qa": "node scripts/package-qa.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "5.12.8",
    "ink": "8.0.0",
    "ink-text-input": "6.0.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "bin": {
    "ernie-harness": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "web/dist",
    "src",
    "pnpm-lock.yaml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/user",
    "examples"
  ]
}
